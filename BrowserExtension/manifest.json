{
  "manifest_version": 3,
  "name": "Sanju\u2019s SnapDrive",
  "version": "1.6.0",
  "description": "Capture, annotate, copy, and export screenshots in Chrome, or send them to the SnapDrive Mac editor.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Capture with Sanju\u2019s SnapDrive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open SnapDrive capture"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Capture visible tab and show quick actions"
    },
    "capture-region": {
      "description": "Capture a selected area and show quick actions"
    }
  },
  "background": {
    "service_worker": "capture-worker.js"
  },
  "minimum_chrome_version": "109"
}
